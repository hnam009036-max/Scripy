-- PHẦN 3: LÕI XỬ LÝ CHÍNH
-- ==========================================
runService.Heartbeat:Connect(function()
    local char = player.Character
    if not char then return end
    
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    
    if hum and root then
        -- Xử lý tốc độ
        if _G_Settings.SpeedEnabled then
            hum.WalkSpeed = _G_Settings.WalkSpeedValue
        elseif hum.WalkSpeed > 30 then 
            hum.WalkSpeed = 16 
        end
        
        -- Xử lý Nhảy Cao
        if _G_Settings.JumpEnabled then
            hum.UseJumpPower = true
            hum.JumpPower = _G_Settings.JumpPowerValue
        else
            if hum.JumpPower > 50 then hum.JumpPower = 50 end
        end
        
        -- Xử lý thu nhỏ
        local headScale = hum:FindFirstChild("HeadScale")
        local bodyDepth = hum:FindFirstChild("BodyDepthScale")
        local bodyWidth = hum:FindFirstChild("BodyWidthScale")
        local bodyHeight = hum:FindFirstChild("BodyHeightScale")
        
        if _G_Settings.ShrinkEnabled then
            if headScale then headScale.Value = 0.5 end
            if bodyDepth then bodyDepth.Value = 0.5 end
            if bodyWidth then bodyWidth.Value = 0.5 end
            if bodyHeight then bodyHeight.Value = 0.5 end
        else
            if headScale then headScale.Value = 1 end
            if bodyDepth then bodyDepth.Value = 1 end
            if bodyWidth then bodyWidth.Value = 1 end
            if bodyHeight then bodyHeight.Value = 1 end
        end
        
        -- Xử lý Auto TP
        if _G_Settings.AutoTPEnabled then
            local currentlyHasBomb = false
            for _, item in pairs(char:GetChildren()) do
                if item:IsA("Tool") and (string.find(string.lower(item.Name), "bomb") or string.find(string.lower(item.Name), "time")) then
                    currentlyHasBomb = true
                    break
                end
            end
            
            if currentlyHasBomb then
                if not autoTPLastLocation then autoTPLastLocation = root.CFrame end
                local nearestPlayer = nil
                local minDistance = _G_Settings.MaxStuds
                
                for _, other in pairs(game:GetService("Players"):GetPlayers()) do
                    if other ~= player and other.Character and other.Character:FindFirstChild("HumanoidRootPart") then
                        local otherHum = other.Character:FindFirstChild("Humanoid")
                        local otherRoot = other.Character.HumanoidRootPart
                        
                        if otherHum and otherHum.Health > 0 then
                            local hasForceField = other.Character:FindFirstChildOfClass("ForceField")
                            if not hasForceField then
                                local dist = (root.Position - otherRoot.Position).Magnitude
                                if dist < minDistance and dist > 1 then
                                    minDistance = dist
                                    nearestPlayer = other
                                end
                            end
                        end
                    end
                end
                if nearestPlayer then root.CFrame = nearestPlayer.Character.HumanoidRootPart.CFrame end
            else
                if autoTPLastLocation then
                    root.CFrame = autoTPLastLocation
                    autoTPLastLocation = nil
                end
            end
        end
    end
end)

